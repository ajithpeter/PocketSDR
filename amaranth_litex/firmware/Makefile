# Vahya GNSS Receiver Firmware Makefile
#
# Builds firmware for VexRiscv RISC-V CPU on Vahya board
#
# Usage:
#   make          - Build firmware
#   make clean    - Clean build artifacts
#   make program  - Program firmware to FPGA (requires hardware)

# Toolchain
PREFIX = riscv32-unknown-elf-
CC = $(PREFIX)gcc
OBJCOPY = $(PREFIX)objcopy
OBJDUMP = $(PREFIX)objdump
SIZE = $(PREFIX)size

# Directories
SRC_DIR = src
INC_DIR = include
BUILD_DIR = build

# Target
TARGET = gnss_firmware
ELF = $(BUILD_DIR)/$(TARGET).elf
BIN = $(BUILD_DIR)/$(TARGET).bin
MAP = $(BUILD_DIR)/$(TARGET).map
LST = $(BUILD_DIR)/$(TARGET).lst

# Source files
SRCS = $(wildcard $(SRC_DIR)/*.c)
OBJS = $(SRCS:$(SRC_DIR)/%.c=$(BUILD_DIR)/%.o)

# Include paths
INCLUDES = -I$(INC_DIR)

# Compiler flags
CFLAGS = -march=rv32im -mabi=ilp32
CFLAGS += -O2 -g
CFLAGS += -Wall -Wextra
CFLAGS += -ffunction-sections -fdata-sections
CFLAGS += $(INCLUDES)

# Linker flags
LDFLAGS = -march=rv32im -mabi=ilp32
LDFLAGS += -Wl,--gc-sections
LDFLAGS += -Wl,-Map=$(MAP)
LDFLAGS += -nostartfiles
LDFLAGS += -lm  # Math library for sqrt, sin, cos, etc.

# Linker script (would be generated by LiteX)
# LDFLAGS += -T linker.ld

# Default target
all: $(BUILD_DIR) $(BIN) size

# Create build directory
$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

# Compile C files
$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c
	@echo "CC $<"
	$(CC) $(CFLAGS) -c $< -o $@

# Link
$(ELF): $(OBJS)
	@echo "LD $@"
	$(CC) $(LDFLAGS) $(OBJS) -o $@
	$(OBJDUMP) -D $@ > $(LST)

# Create binary
$(BIN): $(ELF)
	@echo "OBJCOPY $@"
	$(OBJCOPY) -O binary $< $@

# Print size
size: $(ELF)
	@echo ""
	@echo "Size:"
	$(SIZE) $<
	@echo ""

# Clean
clean:
	rm -rf $(BUILD_DIR)

# Program (placeholder - would use litex_term or similar)
program: $(BIN)
	@echo "Programming firmware..."
	@echo "TODO: Use litex_term to upload firmware"
	@echo "  litex_term --kernel $(BIN) /dev/ttyUSB0"

# Phony targets
.PHONY: all clean size program
